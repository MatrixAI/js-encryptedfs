{
  "name": "encryptedfs",
  "version": "4.0.2",
  "author": "Matrix AI",
  "contributors": [
    {
      "name": "Roger Qiu"
    },
    {
      "name": "Aashwin Varshney"
    },
    {
      "name": "Robert Cronin"
    },
    {
      "name": "Scott Morris"
    },
    {
      "name": "Brian Botha"
    }
  ],
  "description": "Virtualised persistent encrypted filesystem",
  "keywords": [
    "filesystem",
    "encryption"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatrixAI/js-encryptedfs.git"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": "./dist/*"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "prepare": "tsc -p ./tsconfig.build.json",
    "build": "shx rm -rf ./dist && tsc -p ./tsconfig.build.json",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "ts-node": "ts-node",
    "tsx": "tsx",
    "test": "node ./scripts/test.mjs",
    "lint": "matrixai-lint",
    "lintfix": "matrixai-lint --fix",
    "docs": "shx rm -rf ./docs && typedoc --gitRevision master --tsconfig ./tsconfig.build.json --out ./docs src",
    "bench": "tsc -p ./tsconfig.build.json && shx rm -rf ./benches/results && tsx ./benches/index.ts"
  },
  "dependencies": {
    "@matrixai/async-init": "^2.1.2",
    "@matrixai/async-locks": "^5.0.2",
    "@matrixai/db": "^6.0.20",
    "@matrixai/errors": "^2.1.3",
    "@matrixai/logger": "^4.0.3",
    "@matrixai/resources": "^2.0.1",
    "@matrixai/workers": "^2.0.1",
    "errno": "^0.1.7",
    "lexicographic-integer": "^1.1.0",
    "node-forge": "^1.3.1",
    "readable-stream": "^3.6.0",
    "resource-counter": "^1.2.4",
    "util-callbackify": "^1.0.0"
  },
  "devDependencies": {
    "@matrixai/lint": "^0.2.4",
    "@fast-check/jest": "^2.1.0",
    "@swc/core": "1.3.82",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.5.7",
    "@types/node-forge": "^1.0.2",
    "@types/readable-stream": "^2.3.11",
    "benny": "^3.7.1",
    "common-tags": "^1.8.2",
    "fast-check": "^4.0.0",
    "jest": "^29.6.2",
    "jest-extended": "^4.0.0",
    "jest-junit": "^16.0.0",
    "shx": "^0.3.4",
    "systeminformation": "^5.18.5",
    "ts-node": "^10.9.1",
    "tsx": "^3.12.7",
    "typedoc": "^0.24.8",
    "typescript": "^5.1.6"
  }
}
